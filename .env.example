# Required Telegram credentials. Get API_ID/API_HASH from https://my.telegram.org
API_ID=123456
API_HASH=replace_me
BOT_TOKEN=123456789:replace_me

# Optional comma-separated Telegram user IDs. Blank means the bot is available to anyone who can message it.
# ALLOWED_USER_IDS=123456789,987654321

# Optional persistent MongoDB database. Leave blank to use built-in SQLite.
MONGO_URI=
MONGO_DATABASE=hs2_telegram_bot
SQLITE_PATH=data/bot.sqlite3

# Optional destination channel/group. If blank, completed videos are sent to the requesting user.
# Example: DESTINATION_CHAT_ID=-1001234567890
DESTINATION_CHAT_ID=

# Optional local cookie file for content you are authorized to access. Never upload cookies to the bot.
COOKIE_FILE=

WORK_DIR=work
MAX_WORKERS=2
MAX_ACTIVE_TASKS_PER_USER=1
MAX_UPLOAD_SIZE_GB=1.9
KEEP_FAILED_FILES=true
LOG_LEVEL=INFO

# Restrict accepted input hosts. Exact domains and their subdomains are allowed.
HOTSTAR_DOMAINS=hotstar.com,jiohotstar.com
SONYLIV_DOMAINS=sonyliv.com,sonyliv.in
