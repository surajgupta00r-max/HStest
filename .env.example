# Required Telegram credentials. Get API_ID/API_HASH from https://my.telegram.org
API_ID=123456
API_HASH=replace_me
BOT_TOKEN=123456789:replace_me

# Optional comma-separated Telegram user IDs. Blank means public access.
# Set this allowlist before deploying a public-facing bot.
# ALLOWED_USER_IDS=123456789,987654321

# Persistence: leave MONGO_URI blank to use built-in SQLite.
MONGO_URI=
MONGO_DATABASE=hs2_telegram_bot
SQLITE_PATH=data/bot.sqlite3

# Optional destination channel/group. If blank, finished media is sent to the requester.
# The bot must be allowed to post in the configured destination.
DESTINATION_CHAT_ID=

# Optional server-side default cookie file (fallback). Users can instead upload their own
# Netscape-format cookies.txt privately via /settings -> Cookies / Session.
# Keep this path private; cookie files are sensitive authentication credentials.
COOKIE_FILE=

# Workspaces and limits
WORK_DIR=work
MAX_WORKERS=2
MAX_DOWNLOAD_WORKERS=2
MAX_UPLOAD_WORKERS=1
MAX_ACTIVE_TASKS_PER_USER=1
MAX_UPLOAD_SIZE_GB=1.9
KEEP_FAILED_FILES=true
LOG_LEVEL=INFO

# Strict input-host allowlists. Exact domains and their proper subdomains are accepted.
HOTSTAR_DOMAINS=hotstar.com,jiohotstar.com
SONYLIV_DOMAINS=sonyliv.com,sonyliv.in

# Optional media enrichment and naming metadata
TMDB_API_KEY=
RIPPER_TAG=HS2
SOURCE_LABEL=WEB-DL

# Optional default custom thumbnail; users can override theirs with /setthumbnail.
# Must be a public HTTPS image URL. Do not put credentials in the URL.
CUSTOM_THUMBNAIL_URL=
